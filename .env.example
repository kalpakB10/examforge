# Copy this file to `.env` and fill in real values for a production deploy.
# In production (NODE_ENV=production) every service will refuse to boot if any
# required var below is missing or set to a known dev-default value.

# ── Runtime mode ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mcquser:mcqpassword@localhost:5432/mcqdb

# ── Redis (for BullMQ queues) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth secrets — MUST be rotated in prod (use `openssl rand -base64 48`) ───
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-prod
SESSION_JWT_SECRET=dev-only-session-secret-do-not-use-in-prod

# ── Frontend origin(s) allowed by CORS. Comma-separate multiple. ─────────────
FRONTEND_ORIGIN=http://localhost:8080

# ── Internal service URLs (used by api-gateway) ──────────────────────────────
QUESTION_BANK_URL=http://localhost:3001
EXAM_GENERATOR_URL=http://localhost:3002
EXAM_SESSION_URL=http://localhost:3003
RESULT_ENGINE_URL=http://localhost:3004
DISPUTE_MANAGER_URL=http://localhost:3005

# ── File-storage paths (inside container) ────────────────────────────────────
UPLOADS_PATH=./uploads
UPLOADS_DIR=/app/uploads/question-images
EXAM_PAPERS_DIR=/app/uploads/exam-papers

# ── Observability (optional) ─────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SLOW_REQUEST_MS=2000
# SLOW_QUERY_MS=500
# PDF_WORKER_CONCURRENCY=1
